// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "!Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-c": "menu::Cancel",
      "escape": "menu::Cancel",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-c": ["terminal::SendKeystroke", "ctrl-c"],
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"],
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
    },
  },
  {
    // NOTE: Re-binding this for overide above bindings
    "context": "vim_mode == insert || vim_mode == visual",
    "bindings": {
      "ctrl-c": "vim::NormalBefore",
      "escape": "vim::NormalBefore",
    },
  },
  {
    "context": "(Workspace || os == linux || os == windows) && !Terminal",
    "bindings": {
      "ctrl-c": ["workspace::SendKeystrokes", "escape"],
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-p": "command_palette::Toggle",
      "cmd-shift-p": "command_palette::Toggle",
      "alt-p": "file_finder::Toggle",
      "cmd-p": "file_finder::Toggle",
      "alt-w": "workspace::CloseActiveDock",
      "cmd-w": "workspace::CloseActiveDock",
      "alt-b": "workspace::ToggleLeftDock",
      "cmd-b": "workspace::ToggleLeftDock",
      "alt-r": "workspace::ToggleRightDock",
      "cmd-r": "workspace::ToggleRightDock",
      "alt-j": "workspace::ToggleBottomDock",
      "cmd-j": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-w": ["pane::CloseActiveItem", { "close_pinned": false }],
      "cmd-w": ["pane::CloseActiveItem", { "close_pinned": false }],
    },
  },
  {
    "context": "SettingsWindow || RulesLibrary",
    "bindings": {
      "alt-w": "workspace::CloseWindow",
      "cmd-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-w": null,
      "ctrl-shift-v": "editor::Paste",
      "cmd-v": "editor::Paste",
    },
  },
  {
    "context": "(Editor && (vim_mode == insert || mode == single_line)) || (BufferSearchBar > Editor) || (ProjectSearchBar > Editor)",
    "bindings": {
      "ctrl-w": [
        "editor::DeleteToPreviousWordStart",
        { "ignore_newlines": false, "ignore_brackets": false },
      ],
    },
  },
  {
    "context": "Editor && !menu && os != macos",
    "bindings": {
      "ctrl-b": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      // NOTE: Git related
      "space g h b": "editor::BlameHover",
      "space g h p": "editor::ToggleSelectedDiffHunks",
      "space g h s": "git::ToggleStaged",
      "space g h r": "git::Restore",
      "space g h R": "git::RestoreFile",
      "space g h n": "editor::GoToHunk",
      // NOTE: Code related
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "ctrl-space": "editor::SelectLargerSyntaxNode",
      "g d": "editor::GoToDefinition",
      "g r": "editor::FindAllReferences",
    },
  },
  {
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      ">": "editor::Indent",
      "<": "editor::Outdent",
    },
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "shift-y": ["workspace::SendKeystrokes", "y $"],
    },
  },
  {
    "context": "Pane",
    "bindings": {
      // NOTE: Search keymaps
      "ctrl-/ f": "project_search::ToggleFilters",
      "ctrl-/ c": "search::ToggleCaseSensitive",
      "ctrl-/ w": "search::ToggleWholeWord",
      "ctrl-/ r": "search::ToggleReplace",
      "ctrl-/ x": "search::ToggleRegex",
      "ctrl-/ q": "buffer_search::Dismiss",
      "ctrl-/ s": "search::ToggleSelection",
    },
  },
  {
    // NOTE: Global keys for moving around and focus panes (exclude Terminal)
    "context": "((VimControl && !menu) || EmptyPane || SharedScreen || MarkdownPreview || SvgPreview || ImageViewer || KeyContextView || (OutlinePanel && not_editing) || (ProjectPanel && not_editing) || (GitPanel && menu) || FileHistoryView || InvalidItem || GitGraph) && !Terminal",
    "bindings": {
      // NOTE: Focusing / Deploy panes
      "space e": "project_panel::ToggleFocus",
      "space x X": "diagnostics::Deploy",
      "space s g": "pane::DeploySearch",
      "space space": "file_finder::Toggle",
      "space f b": "tab_switcher::ToggleAll",
      "space g g": "git_panel::ToggleFocus",
      "space g s": "git::Diff",
      "space s s": "outline::Toggle",
      "space s S": "outline_panel::ToggleFocus",
      // NOTE: Buffer related
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
      "space b b": ["workspace::SendKeystrokes", "space space ctrl-n enter"],
      "space b y": "workspace::CopyRelativePath",
      "H": "pane::ActivatePreviousItem",
      "L": "pane::ActivateNextItem",
      // NOTE: Mark
      "space H": "vim::PushMark",
      "space h": "vim::ToggleMarksView",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "d": "project_panel::Delete",
      "r": "project_panel::Rename",
      "y": "project_panel::Copy",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",
      "h": "project_panel::CollapseSelectedEntry",
      "l": "project_panel::ExpandSelectedEntry",
      "-": "project_panel::SelectParent",
      "C": "project_panel::CollapseAllEntries",
      "shift-j": "menu::SelectNext",
      "shift-k": "menu::SelectPrevious",
      "space": null,
      "enter": [
        "action::Sequence",
        ["project_panel::Open", "workspace::ToggleLeftDock"],
      ],
      "space e": [
        "action::Sequence",
        ["project_panel::ToggleFocus", "workspace::ToggleLeftDock"],
      ],
    },
  },
  {
    // NOTE: Global keys for moving around and focus panes
    "context": "(VimControl && !menu) || EmptyPane || SharedScreen || MarkdownPreview || SvgPreview || ImageViewer || KeyContextView || (OutlinePanel && not_editing) || (ProjectPanel && not_editing) || (GitPanel && menu) || FileHistoryView || InvalidItem || GitGraph || Terminal",
    "bindings": {
      // NOTE: Moving around
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "GitPanel && menu",
    "bindings": {
      "enter": [
        "action::Sequence",
        ["menu::Confirm", "workspace::ToggleLeftDock"],
      ],
      "space g g": [
        "action::Sequence",
        ["git_panel::ToggleFocus", "workspace::ToggleLeftDock"],
      ],
    },
  },
  {
    "context": "(Pane && buffer_search_deployed) > Editor",
    "bindings": {
      "ctrl-k": "search::FocusSearch",
    },
  },
  {
    "context": "ProjectSearchBar > Editor",
    "bindings": {
      "ctrl-j": "project_search::ToggleFocus",
    },
  },
  {
    "context": "Editor && multibuffer",
    "bindings": {
      "ctrl-k": "search::FocusSearch",
    },
  },
  {
    "context": "(Pane && buffer_search_deployed) > BufferSearchBar > Editor",
    "bindings": {
      "ctrl-j": "editor::ToggleFocus",
      "ctrl-k": "menu::Cancel",
    },
  },
]
