// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "on",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "diff_view_style": "unified",
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": "ctx7sk-f904fcfd-7e50-4af4-b335-0054d3ef6915",
      },
    },
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "show_edit_predictions": false,
  "disable_ai": false,
  "agent": {
    "dock": "right",
    "single_file_review": true,
    "show_turn_stats": true,
    "tool_permissions": {
      "default": "allow",
      "tools": {},
    },
    "default_model": {
      "provider": "google",
      "model": "gemini-3-flash-preview",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "vim": {
    "use_smartcase_find": true,
  },
  "scrollbar": {
    "show": "always",
  },
  "restore_on_startup": "launchpad",
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "soft_wrap": "editor_width",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "system",
    "light": "VSCode Icons for Zed (Light Official Icons)",
    "dark": "Catppuccin Frappé",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "relative_line_numbers": "enabled",
  "auto_install_extensions": {
    "html": true,
    "biome": true,
    "dockerfile": true,
    "git-firefly": true,
    "colored-zed-icons-theme": true,
    "comment": true,
    "catppuccin": true,
    "angular": true,
    "lua": true,
  },
  "vertical_scroll_margin": 4,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "show_whitespaces": "trailing",
  "search": {
    "regex": true,
  },
  "tab_size": 2,
  "tabs": {
    "file_icons": true,
    "show_diagnostics": "all",
  },
  "use_smartcase_search": true,
  "formatter": "auto",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "roslyn": {
      "settings": {
        // Unity regenerates 80+ .csproj files; analyze open files only so the
        // server stays responsive instead of churning on the whole solution.
        "csharp|background_analysis": {
          "dotnet_analyzer_diagnostics_scope": "openFiles",
          "dotnet_compiler_diagnostics_scope": "openFiles",
        },
        // Unimported-namespace completions are very handy in Unity (UnityEngine,
        // UnityEngine.UI, etc. get auto-suggested with a using added).
        "csharp|completion": {
          "dotnet_show_completion_items_from_unimported_namespaces": true,
          "dotnet_trigger_completion_in_argument_lists": true,
        },
        // CodeLens off keeps the editor clean while learning; flip to true if you
        // want inline reference/test counts.
        "csharp|code_lens": {
          "dotnet_enable_references_code_lens": false,
          "dotnet_enable_tests_code_lens": false,
        },
      },
    },
  },
  "languages": {
    "JavaScript": {
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.eslint": true, // auto use eslint when formating
      },
    },
    "TypeScript": {
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.eslint": true, // auto use eslint when formating
      },
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "...",
      ],
    },
    "CSharp": {
      "language_servers": ["roslyn", "!csharp-ls", "!omnisharp", "..."],
      "format_on_save": "on",
      "tab_size": 4,
    },
  },
  "file_scan_exclusions": [
    // NOTE: Exlucde these for Unity proj
    // "**/Library",
    // "**/Temp",
    // "**/Obj",
    // "**/obj",
    // "**/Build",
    // "**/Builds",
    // "**/Logs",
    // "**/UserSettings",
    // "**/MemoryCaptures",
    // "**/Recordings",
  ],
}
